# Required in production: generate a random secret of at least 32 characters.
API_KEY=replace-with-random-secret

SEARXNG_URL=http://127.0.0.1:8889
# Engine language preference only; search terms remain Persian.
SEARXNG_LANGUAGE=en-US
# Search keeps Persian local queries; non-.ir hosts require Persian location text.
SEARCH_TIMEOUT=20
SEARCH_BATCH_SIZE=100
SEARCH_RETRY_SECONDS=60
# 0 means no hard page limit; repeated consecutive pages are detected separately.
MAX_SEARCH_PAGES=0

FIRECRAWL_URL=http://127.0.0.1:3002
CRAWL_TIMEOUT=240
MAX_CRAWL_PAGES=10
MAX_CRAWL_DEPTH=2
MAX_CONCURRENT_SITES=1
# Soft pressure pause. Enforce a hard process/container memory cap outside the app (Docker/systemd).
HOST_MEMORY_BUDGET_MB=7168
MEMORY_AVAILABLE_FLOOR_MB=1024
MEMORY_CHECK_INTERVAL_SECONDS=15

JOB_DB_PATH=/opt/business-discovery/data/jobs.sqlite3
JOB_TTL_SECONDS=604800
JOB_CLEANUP_INTERVAL=3600
LOG_LEVEL=INFO
